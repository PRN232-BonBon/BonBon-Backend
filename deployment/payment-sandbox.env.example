# Review-only template. No merchant/JWT/DB credentials belong in this file.
PAYMENT_SANDBOX_API_IMAGE=ghcr.io/prn232-bonbon/bonbon-backend:REPLACE_WITH_REVIEWED_IMMUTABLE_TAG
PAYMENT_SANDBOX_CONFIG_FILE=/private/path/.payment-staging.local.json
# Supply these separately to the approved Caddy service; Compose does not set Caddy's env.
PAYMENT_SANDBOX_HOST=payment-sandbox.example.test
PAYMENT_SANDBOX_FRONTEND_ROOT=/private/path/dist-payment-sandbox
# Documentation-only IP. Replace with exact approved tester /32 or /128; never /0.
PAYMENT_SANDBOX_TESTER_CIDRS=192.0.2.10/32
