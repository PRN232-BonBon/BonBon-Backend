POSTGRES_DB=bonbon
POSTGRES_USER=bonbon_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_KEY=replace-with-a-random-secret-at-least-64-characters
JWT_ISSUER=BonBon.API
JWT_AUDIENCE=BonBon.Client
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Gmail SMTP de gui OTP reset password (dung App Password, khong phai mat khau Gmail).
# Tao tai: Google Account -> Bao mat -> Xac minh 2 buoc -> Mat khau ung dung.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=BonBon
SMTP_OTP_EXPIRY_MINUTES=10
SMTP_OTP_MAX_ATTEMPTS=5
SMTP_RESEND_COOLDOWN_SECONDS=60
FRONTEND_ORIGIN=https://bonbon.kitsuracloud.com
FRONTEND_PREVIEW_ORIGIN=http://localhost:5173
PAYMENT_ENABLED=false
PAYMENT_CHECKOUT_MINUTES=15
# Sandbox merchant only. Set the secret in local environment or secret storage.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
PAYMENT_FRONTEND_RESULT_URL=
