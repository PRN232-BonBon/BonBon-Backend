<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.25" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BonBon.Business\BonBon.Business.csproj" />
    <ProjectReference Include="..\BonBon.Entities\BonBon.Entities.csproj" />
  </ItemGroup>

  <!-- Local credentials are loaded only by explicit absolute path. Git ignore
       does not prevent Web SDK content copying into build/publish artifacts. -->
  <ItemGroup>
    <Content Remove="**/.payment*.local.json" />
    <None Remove="**/.payment*.local.json" />
    <Content Remove="appsettings.Local.json;appsettings.Development.json;secrets.json" />
    <None Remove="appsettings.Local.json;appsettings.Development.json;secrets.json" />
  </ItemGroup>

</Project>
